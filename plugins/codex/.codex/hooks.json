{
  "hooks": {
    "PostModelRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CODEX_HOME}/plugins/burnyourmoneywithslop/dist/post-model-request.js"],
            "timeout": 10,
            "statusMessage": "Sending usage to Burn Your Money With Slop"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CODEX_HOME}/plugins/burnyourmoneywithslop/dist/session-end.js"],
            "timeout": 3,
            "statusMessage": "Finalizing usage tracking"
          }
        ]
      }
    ]
  }
}