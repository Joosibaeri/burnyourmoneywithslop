{
  "name": "howmuchmoneydidyoualreadyburnedwithslop",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run collectors:build && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p plugins/tsconfig.json",
    "collectors:build": "node plugins/build.mjs",
    "collector": "node plugins/collector/dist/index.js",
    "opencode:import": "node plugins/opencode/dist/import-usage.js",
    "cursor:import": "node plugins/cursor/dist/import-usage.js",
    "claude:import": "node plugins/claude-code/dist/import-usage.js",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "prepare": "husky",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:push": "supabase db push --remote --yes",
    "supabase:generate": "supabase gen types typescript --local > src/integrations/supabase/types.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "@types/react-router-dom": "^5.3.3",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "recharts": "^2.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^10.0.1",
    "@opencode/client": "2.3.2",
    "@opencode/plugin": "2.3.2",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "jsonc-parser": "3.3.1",
    "supabase": "3.2.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
